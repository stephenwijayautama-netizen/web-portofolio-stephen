  return (
    <Section id="about" label="Tentang Stephen">
      <AchievementSignal toast={achievements.about} push={push} />
      <SectionHead id="about-title" no="SEKSI 04" title="About Me" sub="Latar belakang, pengalaman, dan side quest yang sedang dikejar." />

      <div className="grid gap-8 md:grid-cols-[1.15fr_0.85fr]">
        <div className="panel p-6 md:p-8">
          <p className="max-w-[46rem] text-paper/80">
            Aku <strong className="text-neon-yellow">{profile.name}</strong>, lulusan{" "}
            <strong className="text-neon-green">{profile.school}</strong> jurusan {profile.major}. Buatku, engineering dan
            desain itu dua sisi koin yang sama: kode yang kencang tapi bikin bingung tetap gagal.
          </p>
          <p className="mt-4 max-w-[46rem] text-paper/80">
            Pengalamanku mencakup magang di <strong className="text-neon-green">{profile.internship}</strong> sebagai Frontend Web Developer, dan freelance di <strong className="text-neon-green">{profile.freelance}</strong> sebagai Full-Stack Developer. Aku terbiasa nyemplung dari wireframe sampai rilis, bikin UI/UX yang enak dan API yang rapi.
          </p>

          <div className="mt-6 rounded-2xl border-[3px] border-dashed border-neon-green bg-navy p-5">
            <p className="hud text-sm text-neon-green">SIDE QUEST</p>
            <p className="mt-1 text-paper/80">
              Eksplorasi AI — <span className="text-neon-yellow">LLM</span> &amp;{" "}
              <span className="text-neon-yellow">RAG</span> — plus arsitektur sistem yang bisa tumbuh. XP-nya lagi
              dikumpulin.
            </p>
          </div>
        </div>

        <div className="grid gap-6 sm:grid-cols-3 md:grid-cols-1">
          <div className="panel flex flex-col items-center justify-center p-6 text-center">
            <Counter to={stats[0].value} suffix={stats[0].suffix} />
            <p className="hud mt-2 text-sm text-paper/70">{stats[0].label.toUpperCase()}</p>
          </div>
          <div className="panel flex flex-col items-center justify-center p-6 text-center">
            <Counter to={stats[1].value} suffix={stats[1].suffix} />
            <p className="hud mt-2 text-sm text-paper/70">{stats[1].label.toUpperCase()}</p>
          </div>
          <div className="panel flex flex-col items-center justify-center p-6 text-center">
            <Counter to={stats[2].value} suffix={stats[2].suffix} />
            <p className="hud mt-2 text-sm text-paper/70">{stats[2].label.toUpperCase()}</p>
          </div>
        </div>
      </div>
    </Section>
  );
}

/* --------------------------------------------------------------- contact */

function SocialIcon({ kind }: { kind: (typeof socials)[number]["icon"] }) {
  const common = { viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", strokeWidth: 2, strokeLinecap: "round" as const, strokeLinejoin: "round" as const, className: "h-6 w-6", "aria-hidden": true };
  if (kind === "code")
    return (
      <svg {...common}>
        <path d="M9 7 4 12l5 5" />
        <path d="m15 7 5 5-5 5" />
      </svg>
    );
  if (kind === "in")
    return (
      <svg {...common}>
        <rect x="3" y="3" width="18" height="18" rx="4" />
        <path d="M7.5 10.5V17M7.5 7.2v.1M11.5 17v-3.6a2.2 2.2 0 0 1 4.4 0V17" />
      </svg>
    );
  return (
    <svg {...common}>
      <rect x="3" y="5" width="18" height="14" rx="3" />
      <path d="m4 7.5 8 5.5 8-5.5" />
    </svg>
  );
}

function Contact() {
  return (
    <Section id="contact" label="Kontak">
      <div className="panel relative overflow-hidden p-8 text-center md:p-14">
        <StarDoodle className="animate-float absolute left-5 top-5 h-9 w-9" />
        <SparkleDoodle className="animate-spin-slow absolute bottom-6 right-6 h-10 w-10" />
        <p className="hud text-sm text-neon-green">MISI TERAKHIR</p>
        <h2 className="comic-title mt-3 text-4xl text-neon-yellow md:text-6xl">Mau kerja sama?</h2>
        <p className="mx-auto mt-4 max-w-[42rem] text-paper/75">
          Terbuka untuk proyek freelance, kolaborasi, dan peluang full-time. Balasannya cepat, diskusinya asyik.
        </p>
        <div className="mt-8 flex flex-wrap justify-center gap-4">
          <a
            href={socials[2].href}
            className="animate-wiggle hud rounded-xl border-[3px] border-navy bg-neon-yellow px-7 py-3 text-lg text-navy shadow-[6px_6px_0_#3A1D8F] transition-all hover:-translate-y-1 hover:shadow-[9px_9px_0_#3A1D8F]"
          >
            Kirim Email
          </a>
          <a
            href={socials[0].href}
            target="_blank"
            rel="noopener noreferrer"
            className="animate-wiggle hud rounded-xl border-[3px] border-navy bg-neon-green px-7 py-3 text-lg text-navy shadow-[6px_6px_0_#3A1D8F] transition-all hover:-translate-y-1 hover:shadow-[9px_9px_0_#3A1D8F]"
          >
            Buka GitHub
          </a>
        </div>
      </div>
    </Section>
  );
}

/* ------------------------------------------------------------ social rail */

function SocialRail({ ready }: { ready: boolean }) {
  const labelCls = "hud absolute left-full ml-3 whitespace-nowrap rounded-md border-2 border-violet bg-navy px-2 py-1 text-xs text-neon-green opacity-0 translate-x-[-6px] transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100";

  return (
    <>
      <motion.nav
        aria-label="Tautan sosial"
        initial="hidden"
        animate={ready ? "show" : "hidden"}
        className="fixed left-4 top-1/2 z-40 hidden -translate-y-1/2 flex-col gap-3 md:flex"
      >
        {socials.map((s, i) => (
          <motion.a
            key={s.id}
            href={s.href}
            target={s.href.startsWith("http") ? "_blank" : undefined}
            rel="noopener noreferrer"
            aria-label={s.label}
            custom={i}
            variants={{
              hidden: { x: -28, opacity: 0 },
              show: { x: 0, opacity: 1, transition: { type: "spring", stiffness: 260, damping: 17, delay: 1.1 + i * 0.12 } },
            }}
            whileHover={{ scale: 1.12 }}
            className="group relative grid h-12 w-12 place-items-center rounded-xl border-[3px] border-violet bg-purple text-paper transition-colors hover:border-neon-green hover:text-neon-green"
          >
            <SocialIcon kind={s.icon} />
            <span className={labelCls}>{s.label}</span>
          </motion.a>
        ))}
      </motion.nav>

      <nav
        aria-label="Tautan sosial"
        className="fixed inset-x-0 bottom-0 z-40 flex items-center justify-around gap-2 border-t-[3px] border-violet bg-purple/95 px-4 py-2 backdrop-blur md:hidden"
      >
        {socials.map((s) => (
          <a
            key={s.id}
            href={s.href}
            target={s.href.startsWith("http") ? "_blank" : undefined}
            rel="noopener noreferrer"
            className="hud flex items-center gap-2 px-3 py-1.5 text-xs text-paper hover:text-neon-green"
          >
            <SocialIcon kind={s.icon} />
            {s.label.toUpperCase()}
          </a>
        ))}
      </nav>
    </>
  );
}

/* ------------------------------------------------------------------ root */

export default function Portfolio() {
  const [ready, setReady] = useState(false);
  const [toasts, setToasts] = useState<Toast[]>([]);

  const px = useMotionValue(0.5);
  const py = useMotionValue(0.5);

  useEffect(() => {
    const move = (e: MouseEvent) => {
      px.set(e.clientX / Math.max(1, window.innerWidth));
      py.set(e.clientY / Math.max(1, window.innerHeight));
    };
    window.addEventListener("mousemove", move, { passive: true });
    return () => window.removeEventListener("mousemove", move);
  }, [px, py]);

  const push = useCallback((t: Toast) => {
    setToasts((prev) => (prev.some((x) => x.id === t.id) ? prev : [...prev.slice(-2), t]));
  }, []);
  const close = useCallback((id: string) => setToasts((prev) => prev.filter((t) => t.id !== id)), []);

  return (
    <MotionConfig reducedMotion="user">
      <AnimatePresence>
        {ready ? null : <Intro key="intro" onDone={() => setReady(true)} />}
      </AnimatePresence>

      <XpHud />
      <CursorFollower />
      <SocialRail ready={ready} />
      <ToastStack toasts={toasts} onClose={close} />

      <main className="pb-24 md:pb-0">
        <Hero px={px} py={py} ready={ready} push={push} />
        <Marquee />
        <Showreel push={push} />
        <Projects push={push} />
        <Skills push={push} />
        <About push={push} />
        <Contact />
      </main>

      <footer className="border-t-[3px] border-violet bg-purple px-5 py-8 text-center text-sm text-paper/60 md:px-10">
        <p className="hud text-neon-yellow">STEPHEN WIJAYA UTAMA</p>
        <p className="mt-2">
          © 2026 · Dibangun dengan Next.js, Tailwind CSS &amp; Framer Motion ·{" "}
          <a href="#home" className="text-neon-green hover:underline">
            ke atas
          </a>
        </p>
      </footer>
    </MotionConfig>
  );
}
