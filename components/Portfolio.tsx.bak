}

/* -------------------------------------------------------------- showreel */

function Showreel({ push }: { push: (t: Toast) => void }) {
  const [open, setOpen] = useState(false);
  const [videoOk, setVideoOk] = useState(true);
  const panelRef = useRef<HTMLDivElement>(null);
  const closeRef = useRef<HTMLButtonElement>(null);
  const restoreRef = useRef<HTMLElement | null>(null);
  const revealRef = useRef<HTMLDivElement>(null);
  const seen = useInView(revealRef, { once: true, amount: 0.35 });

  useEffect(() => {
    if (!open) return;
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        setOpen(false);
        return;
      }
      if (e.key !== "Tab") return;
      const nodes = panelRef.current?.querySelectorAll<HTMLElement>("button, video[controls], a[href]");
      if (!nodes || nodes.length === 0) return;
      const list = Array.from(nodes);
      const first = list[0];
      const last = list[list.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    };
    restoreRef.current = document.activeElement as HTMLElement | null;
    document.addEventListener("keydown", onKey);
    document.body.style.overflow = "hidden";
    closeRef.current?.focus();
    return () => {
      document.removeEventListener("keydown", onKey);
      document.body.style.overflow = "";
      restoreRef.current?.focus();
    };
  }, [open]);

  return (
    <Section id="showreel" label="Showreel">
      <SectionHead
        id="showreel-title"
        no="SEKSI 01"
        title="Showreel"
        sub="Potongan cepat cara kerja dan hasil desainku — tekan play untuk versi penuh."
      />

      <div ref={revealRef}>
        <motion.div
          initial={{ clipPath: "inset(46% 0% 46% 0%)" }}
          animate={seen ? { clipPath: "inset(0% 0% 0% 0%)" } : undefined}
          transition={{ duration: 0.9, ease: [0.76, 0, 0.24, 1] }}
          className="panel relative overflow-hidden"
        >
          <div className="relative grid min-h-[240px] place-items-center bg-[radial-gradient(circle_at_30%_20%,#3A1D8F_0%,transparent_55%),radial-gradient(circle_at_80%_80%,#1B1145_0%,#0D0B2A_70%)] p-8 md:min-h-[420px]">
            <StarDoodle className="animate-float absolute left-6 top-6 h-10 w-10" />
            <SparkleDoodle className="animate-spin-slow absolute bottom-8 right-10 h-12 w-12" />
            <div className="text-center">
              <p className="hud text-sm text-neon-green md:text-base">STEPHEN WIJAYA UTAMA</p>
              <p className="comic-title mt-2 text-5xl text-paper md:text-8xl">SHOWREEL 2026</p>
              <button
                onClick={() => setOpen(true)}
                aria-label="Putar showreel"
                data-cursor="big"
                className="animate-play mt-8 grid h-20 w-20 place-items-center rounded-full border-[3px] border-navy bg-neon-yellow text-navy transition-transform hover:scale-110 md:h-24 md:w-24"
              >
                <svg viewBox="0 0 24 24" className="ml-1 h-9 w-9" aria-hidden>
                  <path d="M7 4l13 8-13 8z" fill="currentColor" />
                </svg>
              </button>
            </div>
          </div>
        </motion.div>
      </div>

      <AnimatePresence>
        {open && (
          <motion.div
            key="lightbox"
            className="fixed inset-0 z-[80] grid place-items-center bg-navy/75 p-4 backdrop-blur-md"
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
            onClick={() => setOpen(false)}
            role="dialog"
            aria-modal="true"
            aria-label="Showreel"
          >
            <motion.div
              ref={panelRef}
              onClick={(e) => e.stopPropagation()}
              initial={{ scale: 0.85, opacity: 0 }}
              animate={{ scale: 1, opacity: 1 }}
              exit={{ scale: 0.9, opacity: 0 }}
              transition={{ type: "spring", stiffness: 260, damping: 22 }}
              className="panel w-full max-w-3xl p-4"
            >
              <div className="mb-3 flex items-center justify-between gap-4">
                <p className="hud text-sm text-neon-green md:text-base">SHOWREEL 2026</p>
                <button
                  ref={closeRef}
                  onClick={() => setOpen(false)}
                  aria-label="Tutup showreel"
                  className="hud rounded-lg border-2 border-violet px-3 py-1 text-sm text-paper hover:border-neon-yellow hover:text-neon-yellow"
                >
                  ESC / X
                </button>
              </div>
              {videoOk ? (
                <video
                  src="/showreel.mp4"
                  controls
                  playsInline
                  preload="metadata"
                  onError={() => setVideoOk(false)}
                  className="aspect-video w-full rounded-xl border-2 border-violet bg-navy"
                />
              ) : (
                <div className="grid aspect-video place-items-center rounded-xl border-2 border-violet bg-navy p-6 text-center">
                  <div>
                    <p className="hud text-lg text-neon-yellow">VIDEO BELUM DIPASANG</p>
                    <p className="mt-2 text-sm text-paper/70">
                      Taruh file di <code className="text-neon-green">public/showreel.mp4</code> untuk mengaktifkan showreel.
                    </p>
                  </div>
                </div>
              )}
            </motion.div>
          </motion.div>
        )}
      </AnimatePresence>
    </Section>
  );
}

/* -------------------------------------------------------------- projects */

const accents: Record<Project["accent"], { bar: string; text: string; shadow: string }> = {
  yellow: { bar: "bg-neon-yellow", text: "text-neon-yellow", shadow: "shadow-[6px_6px_0_#F5FF3B] hover:shadow-[11px_11px_0_#F5FF3B]" },
  green: { bar: "bg-neon-green", text: "text-neon-green", shadow: "shadow-[6px_6px_0_#39FF88] hover:shadow-[11px_11px_0_#39FF88]" },
  violet: { bar: "bg-violet", text: "text-paper", shadow: "shadow-[6px_6px_0_#6B49C9] hover:shadow-[11px_11px_0_#6B49C9]" },
};

function ProjectCard({ project }: { project: Project }) {
  const rx = useSpring(0, { stiffness: 190, damping: 18 });
  const ry = useSpring(0, { stiffness: 190, damping: 18 });
  const shine = useTransform(ry, [-16, 16], [-160, 160]);
  const accent = accents[project.accent];

  const onMove = (e: ReactPointerEvent<HTMLElement>) => {
    const rect = e.currentTarget.getBoundingClientRect();
    const px = (e.clientX - rect.left) / rect.width;
    const py = (e.clientY - rect.top) / rect.height;
    ry.set(Math.max(-16, Math.min(16, (px - 0.5) * 32)));
    rx.set(Math.max(-14, Math.min(14, (0.5 - py) * 28)));
  };

  const reset = () => {
    rx.set(0);
    ry.set(0);
  };

  return (
    <motion.article
      onPointerMove={onMove}
      onPointerLeave={reset}
      onPointerCancel={reset}
      data-cursor="big"
      whileHover={{ y: -8 }}
      style={{ rotateX: rx, rotateY: ry, transformPerspective: 1000 }}
      className={`panel relative w-[86%] shrink-0 snap-center overflow-hidden p-6 transition-shadow duration-300 sm:w-[440px] md:p-7 ${accent.shadow}`}
    >
      <div className="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden>
        <motion.div
          style={{ x: shine }}
          className="absolute inset-y-0 -inset-x-24 bg-[linear-gradient(105deg,transparent_38%,rgba(244,242,255,0.18)_50%,transparent_62%)]"
        />
      </div>

      <div className="relative">
        <div className="flex items-start justify-between gap-4">
          <span className={`hud text-5xl ${accent.text}`}>{project.no}</span>
          <span className={`mt-2 h-3 w-16 rounded-full ${accent.bar}`} />
        </div>
        <h3 className="comic-title mt-4 text-3xl text-paper md:text-4xl">{project.title}</h3>
        <p className="mt-3 text-[0.98rem] text-paper/75">{project.desc}</p>

        <div className="mt-5 flex flex-wrap gap-2">
          {project.stack.map((s) => (
            <span key={s} className="chip text-paper/85">
              {s}
            </span>
          ))}
        </div>

        <p className="hud mt-5 border-t-2 border-violet pt-4 text-sm text-neon-green">PERAN: {project.role.toUpperCase()}</p>
      </div>
    </motion.article>
  );
}

function Projects({ push }: { push: (t: Toast) => void }) {
  const trackRef = useRef<HTMLDivElement>(null);
  const drag = useRef<{ x: number; left: number } | null>(null);

  const scrollBy = (dir: 1 | -1) => {
    const el = trackRef.current;
    if (el) el.scrollBy({ left: dir * Math.min(el.clientWidth * 0.85, 460), behavior: "smooth" });
  };

  const down = (e: ReactPointerEvent<HTMLDivElement>) => {
    if (e.pointerType !== "mouse") return;
    const el = e.currentTarget;
    drag.current = { x: e.clientX, left: el.scrollLeft };
    el.setPointerCapture(e.pointerId);
  };
  const move = (e: ReactPointerEvent<HTMLDivElement>) => {
    const d = drag.current;
    if (d) e.currentTarget.scrollLeft = d.left - (e.clientX - d.x);
  };
  const up = () => {
    drag.current = null;
  };

  return (
    <Section id="projects" label="Proyek unggulan">
      <AchievementSignal toast={achievements.projects} push={push} />
      <SectionHead
        id="projects-title"
        no="SEKSI 02"
        title="Featured Projects"
        sub="Tiga proyek yang paling mewakili cara aku membangun sistem end-to-end."
        aside={
          <div className="flex gap-3">
            <button onClick={() => scrollBy(-1)} aria-label="Proyek sebelumnya" className="hud grid h-12 w-12 place-items-center rounded-xl border-[3px] border-violet bg-navy text-xl text-neon-yellow transition-colors hover:border-neon-yellow">
              &lt;
            </button>
            <button onClick={() => scrollBy(1)} aria-label="Proyek berikutnya" className="hud grid h-12 w-12 place-items-center rounded-xl border-[3px] border-violet bg-navy text-xl text-neon-yellow transition-colors hover:border-neon-yellow">
              &gt;
            </button>
          </div>
        }
      />

      <div
        ref={trackRef}
        onPointerDown={down}
        onPointerMove={move}
        onPointerUp={up}
        onPointerLeave={up}
        className="no-scrollbar flex snap-x snap-mandatory gap-6 overflow-x-auto pb-6 pt-2 [scroll-padding-inline:1rem] [scrollbar-gutter:stable] md:cursor-grab md:active:cursor-grabbing"
      >
        {projects.map((p) => (
          <ProjectCard key={p.title} project={p} />
        ))}
      </div>
      <p className="hud mt-2 text-xs text-paper/50">SERET / GESER UNTUK LIHAT LAINNYA</p>
    </Section>
  );
}

/* ---------------------------------------------------------------- skills */

function Skills({ push }: { push: (t: Toast) => void }) {
  const wrapRef = useRef<HTMLDivElement>(null);
  const [hovered, setHovered] = useState<number | null>(null);

  return (
    <Section id="skills" label="Skillset">
      <AchievementSignal toast={achievements.skills} push={push} />
      <SectionHead
        id="skills-title"
        no="SEKSI 03"
        title="Skillset"
        sub="Skill unggahan yang bisa kamu tarik-pagar, arahkan kursor untuk melihat levelnya."
      />

      <div ref={wrapRef} className="relative grid grid-cols-3 place-items-center gap-x-4 gap-y-10 sm:grid-cols-4 md:grid-cols-5 md:gap-x-8">
        {skills.map((s, i) => (
          <div key={s.name} className="relative" onPointerEnter={() => setHovered(i)} onPointerLeave={() => setHovered((h) => (h === i ? null : h))}>
            <motion.div
              animate={{ y: [0, -14, 0] }}
              transition={{ duration: 3.2 + (i % 5) * 0.4, repeat: Infinity, ease: "easeInOut", delay: i * 0.18 }}
            >
              <motion.div
                drag
                dragSnapToOrigin
                dragConstraints={wrapRef}
                dragElastic={0.3}
                whileDrag={{ scale: 1.15, zIndex: 30 }}
                data-cursor="big"
                className="panel hud grid h-20 w-20 cursor-grab select-none place-items-center rounded-2xl text-2xl text-neon-yellow transition-colors hover:border-neon-green hover:text-neon-green active:cursor-grabbing md:h-24 md:w-24 md:text-3xl"
                aria-label={`${s.name}, level ${s.level} dari 5`}
              >
                {s.abbr}
              </motion.div>
            </motion.div>

            <div className="pointer-events-none absolute bottom-full left-1/2 z-30 mb-3 w-52 -translate-x-1/2">
              <AnimatePresence>
                {hovered === i && (
                  <motion.div
                    key="tip"
                    initial={{ opacity: 0, y: 10, scale: 0.9 }}
                    animate={{ opacity: 1, y: 0, scale: 1 }}
                    exit={{ opacity: 0, y: 8, scale: 0.92 }}
                    transition={{ type: "spring", stiffness: 380, damping: 22 }}
                    className="rounded-xl border-[3px] border-neon-yellow bg-navy p-3 text-left shadow-[5px_5px_0_#3A1D8F]"
                  >
                    <p className="hud text-sm text-neon-yellow">{s.name.toUpperCase()}</p>
                    <p className="mt-1 text-xs leading-snug text-paper/75">{s.note}</p>
                    <div className="mt-2 flex items-center gap-2">
                      <div className="h-2 flex-1 overflow-hidden rounded-full bg-purple">
                        <motion.div
                          initial={{ scaleX: 0 }}
                          animate={{ scaleX: s.level / 5 }}
                          transition={{ type: "spring", stiffness: 160, damping: 20 }}
                          className="h-full origin-left rounded-full bg-neon-green"
                        />
                      </div>
                      <span className="hud text-xs text-neon-green">LV{s.level}</span>
                    </div>
                  </motion.div>
                )}
              </AnimatePresence>
            </div>
          </div>
        ))}
      </div>
    </Section>
  );
}

/* ----------------------------------------------------------------- about */

