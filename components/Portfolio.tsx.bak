"use client";

import {
  useCallback,
  useEffect,
  useRef,
  useState,
  type PointerEvent as ReactPointerEvent,
  type ReactNode,
} from "react";
import {
  AnimatePresence,
  MotionConfig,
  motion,
  useAnimationControls,
  useInView,
  useMotionValue,
  useMotionValueEvent,
  useScroll,
  useSpring,
  useTransform,
  type MotionValue,
} from "framer-motion";

import {
  achievements,
  clickLines,
  navLinks,
  profile,
  projects,
  skills,
  socials,
  stats,
  techStack,
  typewriterRoles,
  type Project,
  type Toast,
} from "@/lib/data";
import Avatar from "@/components/Avatar";

/* ------------------------------------------------------------------ utils */

function useTypewriter(target: string, speed = 62) {
  const [txt, setTxt] = useState("");
  useEffect(() => {
    if (txt === target) return;
    const typing = target.startsWith(txt);
    const next = typing ? target.slice(0, txt.length + 1) : target.slice(0, Math.max(0, txt.length - 1));
    const id = setTimeout(() => setTxt(next), typing ? speed : speed / 2);
    return () => clearTimeout(id);
  }, [txt, target, speed]);
  return txt;
}

function prefersReduced() {
  return typeof window !== "undefined" && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
}

function AchievementSignal({ toast, push }: { toast: Toast; push: (t: Toast) => void }) {
  const ref = useRef<HTMLSpanElement>(null);
  const inView = useInView(ref, { once: true });
  const held = useRef(toast);
  held.current = toast;
  useEffect(() => {
    if (inView) push(held.current);
  }, [inView, push]);
  return <span ref={ref} aria-hidden className="pointer-events-none absolute left-1/2 top-1/2 h-px w-px" />;
}

function Counter({ to, suffix }: { to: number; suffix: string }) {
  const ref = useRef<HTMLSpanElement>(null);
  const inView = useInView(ref, { once: true });
  const [n, setN] = useState(0);
  useEffect(() => {
    if (!inView) return;
    if (prefersReduced()) {
      setN(to);
      return;
    }
    let raf = 0;
    const start = performance.now();
    const tick = (t: number) => {
      const p = Math.min(1, (t - start) / 1100);
      setN(Math.round(to * (1 - Math.pow(1 - p, 3))));
      if (p < 1) raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);
    return () => cancelAnimationFrame(raf);
  }, [inView, to]);
  return (
    <span ref={ref} className="comic-title text-5xl text-neon-yellow md:text-6xl">
      {n}
      {suffix}
    </span>
  );
}

function SectionHead({ id, no, title, sub, aside }: { id: string; no: string; title: string; sub: string; aside?: ReactNode }) {
  return (
    <div className="mb-10 flex flex-wrap items-end justify-between gap-6 md:mb-14">
      <div>
        <p className="hud text-sm text-neon-green md:text-base">{no}</p>
        <h2 id={id} className="comic-title mt-2 text-4xl text-neon-yellow md:text-6xl">
          {title}
        </h2>
        <p className="mt-4 max-w-[46rem] text-paper/70">{sub}</p>
      </div>
      {aside}
    </div>
  );
}

function Section({ id, label, children }: { id: string; label: string; children: ReactNode }) {
  return (
    <section id={id} aria-label={label} className="relative scroll-mt-24 px-5 py-20 md:px-10 md:py-28">
      <div className="mx-auto max-w-6xl">{children}</div>
    </section>
  );
}

/* ----------------------------------------------------------------- doodles */

function StarDoodle({ className = "" }: { className?: string }) {
  return (
    <svg viewBox="0 0 40 40" className={className} aria-hidden>
      <path d="M20 3l5 12 12 1-9.5 7.5L30 35l-10-6.5L10 35l2.5-11.5L3 16l12-1z" fill="#F5FF3B" stroke="#0D0B2A" strokeWidth="3" strokeLinejoin="round" />
    </svg>
  );
}

function SquiggleDoodle({ className = "" }: { className?: string }) {
  return (
    <svg viewBox="0 0 80 30" className={className} aria-hidden>
      <path d="M4 20c8-16 16 12 24-2s16 14 24-2 16 10 24-4" fill="none" stroke="#39FF88" strokeWidth="5" strokeLinecap="round" />
    </svg>
  );
}

function SparkleDoodle({ className = "" }: { className?: string }) {
  return (
    <svg viewBox="0 0 40 40" className={className} aria-hidden>
      <path d="M20 2c1.5 9 6 13.5 18 18-12 4.5-16.5 9-18 18-1.5-9-6-13.5-18-18 12-4.5 16.5-9 18-18z" fill="#39FF88" stroke="#0D0B2A" strokeWidth="2.5" strokeLinejoin="round" />
    </svg>
  );
}

function ArrowDoodle({ className = "" }: { className?: string }) {
  return (
    <svg viewBox="0 0 70 60" className={className} aria-hidden>
      <path d="M6 8c30 2 46 16 50 40" fill="none" stroke="#F5FF3B" strokeWidth="5" strokeLinecap="round" />
      <path d="M44 40l12 10 6-14" fill="none" stroke="#F5FF3B" strokeWidth="5" strokeLinecap="round" strokeLinejoin="round" />
    </svg>
  );
}

function Parallax({
  px,
  py,
  rx,
  ry,
  className = "",
  children,
}: {
  px: MotionValue<number>;
  py: MotionValue<number>;
  rx: [number, number];
  ry: [number, number];
  className?: string;
  children: ReactNode;
}) {
  const x = useTransform(px, [0, 1], rx);
  const y = useTransform(py, [0, 1], ry);
  return (
    <motion.div style={{ x, y }} className={className}>
      {children}
    </motion.div>
  );
}

/* ------------------------------------------------------------------ intro */

function Intro({ onDone }: { onDone: () => void }) {
  const [count, setCount] = useState(0);
  useEffect(() => {
    const start = performance.now();
    let raf = 0;
    const tick = (t: number) => {
      const p = Math.min(1, (t - start) / 900);
      setCount(Math.round(p * 100));
      if (p < 1) raf = requestAnimationFrame(tick);
      else onDone();
    };
    raf = requestAnimationFrame(tick);
    return () => cancelAnimationFrame(raf);
  }, [onDone]);

  return (
    <motion.div className="fixed inset-0 z-[70]" aria-hidden>
      <motion.div
        className="absolute inset-x-0 top-0 h-1/2 border-b-[3px] border-violet bg-navy"
        exit={{ y: "-101%" }}
        transition={{ duration: 0.75, ease: [0.76, 0, 0.24, 1] }}
      />
      <motion.div
        className="absolute inset-x-0 bottom-0 h-1/2 border-t-[3px] border-violet bg-navy"
        exit={{ y: "101%" }}
        transition={{ duration: 0.75, ease: [0.76, 0, 0.24, 1] }}
      />
      <motion.div
        className="absolute inset-0 grid place-items-center"
        exit={{ opacity: 0 }}
        transition={{ duration: 0.25 }}
      >
        <div className="text-center">
          <p className="hud text-7xl text-neon-yellow md:text-9xl">
            {count}
            <span className="text-4xl md:text-6xl">%</span>
          </p>
          <p className="hud mt-2 text-sm text-neon-green md:text-base">LOADING SAVE FILE...</p>
        </div>
      </motion.div>
    </motion.div>
  );
}

/* ------------------------------------------------------------------- HUD */

function XpHud() {
  const { scrollYProgress } = useScroll();
  const smooth = useSpring(scrollYProgress, { stiffness: 140, damping: 30, mass: 0.4 });
  const scaleX = useTransform(smooth, [0, 1], [0.02, 1]);
  const [level, setLevel] = useState(1);
  const [pct, setPct] = useState(0);

  useMotionValueEvent(smooth, "change", (v) => {
    const nextPct = Math.round(v * 100);
    const nextLv = Math.min(5, Math.floor(v * 5) + 1);
    setPct((p) => (p === nextPct ? p : nextPct));
    setLevel((l) => (l === nextLv ? l : nextLv));
  });

  return (
    <header className="fixed inset-x-0 top-0 z-50 border-b-[3px] border-violet bg-navy/90 backdrop-blur-md">
      <div className="mx-auto flex max-w-6xl items-center gap-4 px-4 py-2.5 md:px-10">
        <a href="#home" className="hud shrink-0 text-lg text-neon-yellow md:text-xl" aria-label="Ke atas">
          {profile.shortName.toUpperCase()}
          <span className="text-neon-green">.</span>
        </a>

        <div className="hidden min-w-0 flex-1 items-center gap-3 sm:flex">
          <div className="h-3 w-full overflow-hidden rounded-full border-2 border-violet bg-navy">
            <motion.div className="h-full origin-left rounded-full bg-neon-green" style={{ scaleX }} />
          </div>
          <span className="hud shrink-0 text-xs text-paper/70 md:text-sm">{pct}%</span>
        </div>

        <nav aria-label="Navigasi utama" className="no-scrollbar -mx-1 flex min-w-0 flex-1 items-center gap-3 overflow-x-auto px-1 sm:flex-none sm:justify-end">
          {navLinks.map((l) => (
            <a key={l.id} href={`#${l.id}`} className="hud whitespace-nowrap text-xs text-paper/70 transition-colors hover:text-neon-green md:text-sm">
              {l.label}
            </a>
          ))}
        </nav>

        <motion.span
          key={level}
          initial={{ scale: 1.35, opacity: 0 }}
          animate={{ scale: 1, opacity: 1 }}
          transition={{ type: "spring", stiffness: 420, damping: 16 }}
          className="hud shrink-0 rounded-md border-2 border-neon-yellow bg-neon-yellow px-2 py-0.5 text-xs text-navy md:text-sm"
          aria-label={`Level ${level}`}
        >
          LV{level}
        </motion.span>
      </div>
      <div className="h-1.5 w-full overflow-hidden bg-purple">
        <motion.div className="h-full origin-left bg-neon-yellow" style={{ scaleX }} />
      </div>
    </header>
  );
}

/* ---------------------------------------------------------------- cursor */

function CursorFollower() {
  const [fine, setFine] = useState(false);
  const [big, setBig] = useState(false);
  const x = useMotionValue(-100);
  const y = useMotionValue(-100);
  const sx = useSpring(x, { stiffness: 520, damping: 40, mass: 0.5 });
  const sy = useSpring(y, { stiffness: 520, damping: 40, mass: 0.5 });

  useEffect(() => {
    setFine(window.matchMedia("(pointer: fine)").matches && !prefersReduced());
  }, []);

  useEffect(() => {
    if (!fine) return;
    const move = (e: MouseEvent) => {
      x.set(e.clientX);
      y.set(e.clientY);
    };
    const over = (e: MouseEvent) => {
      const el = e.target as Element | null;
      setBig(!!el && typeof el.closest === "function" && !!el.closest("a, button, [data-cursor='big']"));
    };
    window.addEventListener("mousemove", move, { passive: true });
    window.addEventListener("mouseover", over);
    return () => {
      window.removeEventListener("mousemove", move);
      window.removeEventListener("mouseover", over);
    };
  }, [fine, x, y]);

  if (!fine) return null;

  return (
    <motion.div
      aria-hidden
      className="pointer-events-none fixed left-0 top-0 z-[90] -ml-4 -mt-4 h-8 w-8 rounded-full border-[3px] border-neon-yellow"
      style={{ x: sx, y: sy }}
      animate={{ scale: big ? 1.9 : 1, backgroundColor: big ? "rgba(57,255,136,0.25)" : "rgba(57,255,136,0)" }}
      transition={{ type: "spring", stiffness: 340, damping: 22 }}
    />
  );
}

/* ---------------------------------------------------------------- toasts */

function ToastItem({ toast, onClose }: { toast: Toast; onClose: (id: string) => void }) {
  useEffect(() => {
    const id = setTimeout(() => onClose(toast.id), 4200);
    return () => clearTimeout(id);
  }, [toast.id, onClose]);

  return (
    <motion.div
      layout
      role="status"
      initial={{ opacity: 0, x: 60, scale: 0.9 }}
      animate={{ opacity: 1, x: 0, scale: 1 }}
      exit={{ opacity: 0, x: 60, scale: 0.95 }}
      transition={{ type: "spring", stiffness: 320, damping: 24 }}
      className="panel pointer-events-auto flex w-72 items-start gap-3 p-3.5"
    >
      <span className="grid h-9 w-9 shrink-0 place-items-center rounded-lg border-2 border-navy bg-neon-yellow text-navy">
        <StarDoodle className="h-5 w-5" />
      </span>
      <div className="min-w-0">
        <p className="hud text-sm text-neon-green">{toast.title}</p>
        <p className="text-sm leading-snug text-paper/80">{toast.body}</p>
      </div>
      <button onClick={() => onClose(toast.id)} aria-label="Tutup notifikasi" className="hud ml-auto shrink-0 text-lg leading-none text-paper/60 hover:text-neon-yellow">
        x
      </button>
    </motion.div>
  );
}

function ToastStack({ toasts, onClose }: { toasts: Toast[]; onClose: (id: string) => void }) {
  return (
    <div className="pointer-events-none fixed bottom-24 right-4 z-[65] flex flex-col gap-3 md:bottom-6 md:right-6" aria-live="polite">
      <AnimatePresence>
        {toasts.map((t) => (
          <ToastItem key={t.id} toast={t} onClose={onClose} />
        ))}
      </AnimatePresence>
    </div>
  );
}

/* ------------------------------------------------------------------ hero */

function Hero({
  px,
  py,
  ready,
  push,
}: {
  px: MotionValue<number>;
  py: MotionValue<number>;
  ready: boolean;
  push: (t: Toast) => void;
}) {
  const words = profile.headline.split(" ");
  const [roleIdx, setRoleIdx] = useState(0);
  const [nudge, setNudge] = useState<string | null>(null);
  const bubbleTarget = nudge ?? typewriterRoles[roleIdx];
  const typed = useTypewriter(bubbleTarget);

  useEffect(() => {
    if (nudge) return;
    const id = setTimeout(() => setRoleIdx((i) => (i + 1) % typewriterRoles.length), 3600);
    return () => clearTimeout(id);
  }, [roleIdx, nudge]);

  const poke = () => {
    setNudge(clickLines[Math.floor(Math.random() * clickLines.length)]);
    setTimeout(() => setNudge(null), 1800);
  };

  return (
    <section id="home" aria-label="Sapaan" className="relative scroll-mt-24 px-5 pb-10 pt-32 md:px-10 md:pt-40">
      <AchievementSignal toast={achievements.hero} push={push} />

      <Parallax px={px} py={py} rx={[-26, 26]} ry={[-18, 18]} className="pointer-events-none absolute left-4 top-24 md:left-16">
        <StarDoodle className="animate-float h-12 w-12 md:h-16 md:w-16" />
      </Parallax>
      <Parallax px={px} py={py} rx={[20, -20]} ry={[14, -14]} className="pointer-events-none absolute right-6 top-28 md:right-24">
        <SparkleDoodle className="animate-spin-slow h-10 w-10 md:h-14 md:w-14" />
      </Parallax>
      <Parallax px={px} py={py} rx={[-14, 14]} ry={[22, -22]} className="pointer-events-none absolute bottom-32 left-6 hidden md:block">
        <SquiggleDoodle className="animate-float h-10 w-28" />
      </Parallax>
      <Parallax px={px} py={py} rx={[16, -16]} ry={[-12, 12]} className="pointer-events-none absolute bottom-40 right-10 hidden md:block">
        <ArrowDoodle className="animate-float h-16 w-20" />
      </Parallax>

      <div className="mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-[1.1fr_0.9fr] md:gap-8">
        <div>
          <motion.span
            initial={{ opacity: 0, y: 16 }}
            animate={ready ? { opacity: 1, y: 0 } : { opacity: 0, y: 16 }}
            transition={{ delay: 0.15 }}
            className="hud inline-block rounded-full border-[3px] border-neon-green px-4 py-1 text-sm text-neon-green"
          >
            AVAILABLE FOR WORK
          </motion.span>

          <h1 className="comic-title mt-5 flex flex-wrap gap-x-4 gap-y-1 text-[15vw] leading-[0.95] text-paper sm:text-6xl md:text-7xl lg:text-8xl">
            {words.map((w, wi) => (
              <span key={w} className="inline-flex overflow-hidden pb-2">
                {w.split("").map((ch, ci) => (
                  <motion.span
                    key={`${wi}-${ci}`}
                    initial={{ y: "110%", opacity: 0 }}
                    animate={ready ? { y: "0%", opacity: 1 } : { y: "110%", opacity: 0 }}
                    transition={{ type: "spring", stiffness: 380, damping: 22, delay: 0.25 + (wi * 3 + ci) * 0.045 }}
                    className={wi === words.length - 1 ? "text-neon-yellow" : undefined}
                  >
                    {ch}
                  </motion.span>
                ))}
              </span>
            ))}
          </h1>

          <motion.p
            initial={{ opacity: 0, y: 16 }}
            animate={ready ? { opacity: 1, y: 0 } : { opacity: 0, y: 16 }}
            transition={{ delay: 0.75 }}
            className="mt-4 max-w-[46rem] text-lg text-paper/75 md:text-xl"
          >
            {profile.role} — dari <span className="text-neon-green">wireframe</span> sampai{" "}
            <span className="text-neon-green">deploy</span>. Bikin aplikasi yang cepat, rapi, dan enak dipakai.
          </motion.p>

          <motion.div
            initial={{ opacity: 0, y: 16 }}
            animate={ready ? { opacity: 1, y: 0 } : { opacity: 0, y: 16 }}
            transition={{ delay: 0.95 }}
            className="mt-8 flex flex-wrap gap-4"
          >
            <a
              href="#projects"
              className="animate-wiggle hud rounded-xl border-[3px] border-navy bg-neon-yellow px-7 py-3 text-lg text-navy shadow-[6px_6px_0_#3A1D8F] transition-all hover:-translate-y-1 hover:shadow-[9px_9px_0_#3A1D8F]"
            >
              Lihat Proyek
            </a>
            <a
              href="#contact"
              className="animate-wiggle hud rounded-xl border-[3px] border-navy bg-neon-green px-7 py-3 text-lg text-navy shadow-[6px_6px_0_#3A1D8F] transition-all hover:-translate-y-1 hover:shadow-[9px_9px_0_#3A1D8F]"
            >
              Hubungi Aku
            </a>
          </motion.div>
        </div>

        <motion.div
          initial={{ opacity: 0, scale: 0.85 }}
          animate={ready ? { opacity: 1, scale: 1 } : { opacity: 0, scale: 0.85 }}
          transition={{ type: "spring", stiffness: 180, damping: 16, delay: 0.3 }}
          className="relative mx-auto w-full max-w-[380px]"
        >
          <div className="relative mx-auto aspect-square w-[78%]">
            <Avatar px={px} py={py} onPoke={poke} />

            <div className="absolute -top-4 right-0 max-w-[62%] md:-right-6">
              <div className="relative rounded-3xl border-[3px] border-navy bg-paper px-4 py-3 text-navy shadow-[5px_5px_0_#3A1D8F]">
                <p className="min-h-[2.6rem] text-sm font-bold leading-snug md:text-base">
                  {typed}
                  <span className="animate-pulse text-neon-green">|</span>
                </p>
                <span className="absolute -bottom-3 left-8 h-5 w-5 rotate-45 border-b-[3px] border-r-[3px] border-navy bg-paper" />
              </div>
            </div>
          </div>

          <p className="hud mt-6 text-center text-xs text-paper/50 md:text-sm">
            KLIK AVATARNYA — DIA BISA LOMPAT
          </p>
        </motion.div>
      </div>
    </section>
  );
}

/* --------------------------------------------------------------- marquee */

function Marquee() {
  const items = [...techStack, ...techStack];
  return (
    <div className="overflow-hidden border-y-[3px] border-violet bg-purple py-4" aria-label="Tech stack">
      <div className="animate-marquee flex w-max items-center gap-8 pr-8">
        {items.map((t, i) => (
          <span key={`${t}-${i}`} className="hud flex items-center gap-8 text-lg text-paper/85 md:text-2xl">
            {t}
            <StarDoodle className="h-5 w-5 shrink-0 md:h-6 md:w-6" />
          </span>
        ))}
      </div>
